# 설정 양식입니다. 실제 키는 .env에만 입력합니다.
OPENAI_API_KEY=
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=capstone-all-total
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LLM_BACKEND=openai
SUPERVISOR_VERSION=v2
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_QUALITY_MODEL=gpt-4o
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_FAST_MODEL=qwen3.5:2b
OLLAMA_QUALITY_MODEL=qwen3:8b
RAG_ENABLED=true
RAG_EMBEDDING_BACKEND=ollama
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=1
SIMULATE_TOOL_TIMEOUT=false

# 추가 개선: 실제 로컬 모니터링, 검증, 호출 제한, 명시적인 모델 단가
MONITORING_BACKEND=hybrid
MONITORING_SOURCES_PATH=
PROMETHEUS_URL=
PROMETHEUS_TOKEN=
SEMANTIC_VALIDATION=true
RAG_MIN_SCORE=0.35
MODEL_DEADLINE_SECONDS=300
MODEL_PRICES_JSON={}

# 선택: 운영 정책과 검색 문서 폴더 (비워두면 기본 경로 사용)
# AGENT_POLICY_PATH=data/agent_policy.json
# RUNBOOK_DIRECTORY=data/runbooks

# 웹 화면이 연결할 에이전트 API 주소
BACKEND_URL=http://127.0.0.1:8100
